---
import { tinaField } from '@tinacms/astro/tina-field';

import type { ContactContent, SiteSettings } from '../lib/site-data';
import { resolveGoogleMapsEmbedUrl } from '../lib/maps';
import {
	asTinaRecord,
	type TinaPageBlockDocument,
	type TinaSiteDocument
} from '../lib/tina/data';
import Button from './ui/Button.astro';
import Card from './ui/Card.astro';
import Container from './ui/Container.astro';
import Field from './ui/Field.astro';
import RichText from './RichText.astro';
import Section from './ui/Section.astro';

interface Props {
	contact: ContactContent;
	site: SiteSettings;
	showForm?: boolean;
	contactSource?: TinaPageBlockDocument | null;
	siteSource?: TinaSiteDocument;
}

const { contact, site, showForm = contact.mode === 'form', contactSource, siteSource } = Astro.props;
const ui = site.ui;
const uiSource = siteSource?.ui;
const noticeSource = asTinaRecord(contactSource?.notice);
const imageSrc = contact.image?.trim();
const imageAlt = contact.imageAlt?.trim() || `Praxisraum von ${site.owner}`;
const mapEmbedUrl = resolveGoogleMapsEmbedUrl(contact.mapEmbedUrl);
const hasLocationCard = Boolean(imageSrc || mapEmbedUrl);
---

<Section tight class="py-4 sm:py-6">
	<Container>
		<div class="grid gap-3 lg:grid-cols-2">
			<Card class="flex h-full flex-col p-4 sm:p-5">
				{contact.body && (
					<RichText
						content={contact.body}
						class="prose-flow contact-copy max-w-none"
						allowTelephone
						tinaField={tinaField(contactSource, 'body')}
					/>
				)}
				{contact.notice && (
					<Card as="div" tone="accent" class="mt-auto p-3 sm:p-4" tinaField={tinaField(noticeSource)}>
						{contact.notice.title && <h3 class="text-base leading-6 text-[var(--text)]" data-tina-field={tinaField(noticeSource, 'title')}>{contact.notice.title}</h3>}
						<p class:list={['text-sm leading-6 text-[var(--muted)]', contact.notice.title && 'mt-1']} data-tina-field={tinaField(noticeSource, 'text')}>{contact.notice.text}</p>
					</Card>
				)}
			</Card>

			{hasLocationCard && (
				<Card as="div" class="overflow-hidden p-0">
					{imageSrc && (
						<figure class="border-b border-[var(--border-color)] bg-[var(--bg-soft)]" data-tina-field={tinaField(contactSource, 'image')}>
							<img
								src={imageSrc}
								alt={imageAlt}
								width={800}
								height={533}
								loading="lazy"
								decoding="async"
								class="aspect-[16/9] w-full object-cover"
								data-tina-field={tinaField(contactSource, 'imageAlt')}
							/>
						</figure>
					)}
					<div class="p-4 sm:p-5">
						{mapEmbedUrl && (
							<div class="relative aspect-[4/3] min-h-[14rem] overflow-hidden rounded-box border border-[var(--border-color)] sm:aspect-[16/9] sm:min-h-0" data-tina-field={tinaField(contactSource, 'mapEmbedUrl')}>
								<iframe
									src={mapEmbedUrl}
									width="100%"
									height="100%"
									allowfullscreen
									loading="lazy"
									referrerpolicy="strict-origin-when-cross-origin"
									title="Standortkarte"
									class="absolute inset-0 block h-full w-full border-0"
								></iframe>
							</div>
						)}
					</div>
				</Card>
			)}

			{showForm && (
				<form action={`mailto:${site.email}`} method="post" enctype="text/plain">
					<Card as="div" class="space-y-4 p-5 sm:p-6">
						<input
							type="hidden"
							name="subject"
							value={ui.formSubject}
							data-tina-field={tinaField(uiSource, 'formSubject')}
						/>

						<Field name="name" label={ui.formNamePlaceholder} placeholder={ui.formNamePlaceholder} autocomplete="name" tinaField={tinaField(uiSource, 'formNamePlaceholder')} />
						<Field name="email" label={ui.formEmailPlaceholder} type="email" placeholder={ui.formEmailPlaceholder} autocomplete="email" tinaField={tinaField(uiSource, 'formEmailPlaceholder')} />
						<Field name="message" label={ui.formMessagePlaceholder} multiline placeholder={ui.formMessagePlaceholder} tinaField={tinaField(uiSource, 'formMessagePlaceholder')} />
						<Button type="submit" fullWidth tinaField={tinaField(uiSource, 'formSubmitLabel')}>
							{ui.formSubmitLabel}
						</Button>
					</Card>
				</form>
			)}
		</div>
	</Container>
</Section>
