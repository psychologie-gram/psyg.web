---
import { getImage } from 'astro:assets';
import { tinaField } from '@tinacms/astro/tina-field';

import '../styles/global.css';

import { resolveMediaAsset } from '../lib/media';
import type { TinaPageListDocument, TinaSiteDocument } from '../lib/tina/data';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import type { PageData, SiteSettings } from '../lib/site-data';
import { buildStructuredData } from '../lib/structured-data';

interface Props {
	title: string;
	description: string;
	currentPath: string;
	pages: PageData[];
	allPages?: PageData[];
	site: SiteSettings;
	siteDocument: TinaSiteDocument;
	pageSources: TinaPageListDocument[];
}

const { title, description, currentPath, pages, allPages = pages, site, siteDocument, pageSources } = Astro.props;
const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonical = new URL(currentPath, site.siteUrl).toString();
const logoAsset = await resolveMediaAsset('/images/uploads/ag_logo_1536x1536.png');
const faviconAsset = await resolveMediaAsset('/images/uploads/ag_logo_128x128.png');
const portraitAsset = await resolveMediaAsset('/images/uploads/alexandra-gram-portrait.jpg');

if (!logoAsset || logoAsset.kind !== 'optimized') {
	throw new Error('The header logo asset could not be resolved.');
}
if (!faviconAsset || faviconAsset.kind !== 'optimized') {
	throw new Error('The favicon asset could not be resolved.');
}
if (!portraitAsset || portraitAsset.kind !== 'optimized') {
	throw new Error('The structured-data portrait asset could not be resolved.');
}

const logoPreload = await getImage({
	src: logoAsset.source,
	width: 64,
	height: 64,
	widths: [48, 64, 96, 128],
	sizes: '(min-width: 640px) 4rem, 3rem',
	format: 'avif'
});
const portraitImage = await getImage({ src: portraitAsset.source, width: 550, format: 'webp' });
const structuredData = buildStructuredData(site, {
	canonicalUrl: canonical,
	pageTitle,
	description,
	imagePath: portraitImage.src
});
---

<!doctype html>
<html lang={site.lang} data-theme="psychology">
	<head>
		<meta charset="utf-8" /><meta name="theme-color" content="#fffdf7" />
		<script is:inline>
			(() => {
				const themeKey = 'psychologie-theme';
				const lightTheme = 'psychology';
				const darkTheme = 'psychology-dark';
				const root = document.documentElement;

				const readStoredTheme = () => {
					try {
						return window.localStorage.getItem(themeKey);
					} catch (error) {
						console.warn('Theme preference could not be read.', error);
						return null;
					}
				};

				const storeTheme = (theme) => {
					try {
						window.localStorage.setItem(themeKey, theme);
					} catch (error) {
						console.warn('Theme preference could not be saved.', error);
					}
				};

				const syncControls = (theme) => {
					const isDark = theme === darkTheme;
					const label = isDark ? 'Helles Design aktivieren' : 'Dunkles Design aktivieren';
					document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
						button.setAttribute('aria-pressed', String(isDark));
						button.setAttribute('aria-label', label);
						button.setAttribute('title', label);
					});
					document.querySelector('meta[name="theme-color"]')?.setAttribute('content', isDark ? '#101812' : '#fffdf7');
				};

				const applyTheme = (theme, persist = false) => {
					const nextTheme = theme === darkTheme ? darkTheme : lightTheme;
					root.dataset.theme = nextTheme;
					if (persist) {
						storeTheme(nextTheme);
					}
					syncControls(nextTheme);
				};

				applyTheme(readStoredTheme());
				document.addEventListener('click', (event) => {
					const target = event.target;
					if (!(target instanceof Element)) {
						return;
					}
					const toggle = target.closest('[data-theme-toggle]');
					if (!(toggle instanceof HTMLButtonElement)) {
						return;
					}
					applyTheme(root.dataset.theme === darkTheme ? lightTheme : darkTheme, true);
				});
				document.addEventListener('DOMContentLoaded', () => syncControls(root.dataset.theme), { once: true });
			})();
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link
			rel="preload"
			as="image"
			href={logoPreload.src}
			imagesrcset={logoPreload.srcSet.attribute}
			imagesizes="(min-width: 640px) 4rem, 3rem"
			type="image/avif"
		/>
		<link rel="icon" type="image/png" sizes="128x128" href={faviconAsset.source.src} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="de_AT" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:image" content={new URL('/og-image.svg', site.siteUrl).toString()} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL('/og-image.svg', site.siteUrl).toString()} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<a href="#content" class="skip-link" data-tina-field={tinaField(siteDocument.ui, 'skipLinkLabel')}>
			{site.ui.skipLinkLabel}
		</a>
		<div class="relative isolate min-h-screen overflow-x-hidden">
			<SiteHeader pages={pages} currentPath={currentPath} site={site} siteSource={siteDocument} pageSources={pageSources} />
			<main id="content">
				<slot />
			</main>
			<SiteFooter pages={allPages} site={site} siteSource={siteDocument} pageSources={pageSources} />
		</div>
	</body>
</html>
